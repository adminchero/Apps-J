/* ============================================================
   PENDIENTES WIDGET — Dashboard sidebar
   ============================================================ */
function buildPendientesWidget(courses) {
  const all = AppState.getAllPendientes(courses);
  const pending = all.filter(p => !p.done);
  const total = all.length;
  const doneCount = all.filter(p => p.done).length;
  const pct = total ? Math.round(doneCount / total * 100) : 0;

  const showAll = AppState.pendientesFilter === 'all';
  const items = showAll ? all : pending;

  // Group by course → topic
  const grouped = {};
  items.forEach(p => {
    const cKey = p.course.id;
    if (!grouped[cKey]) grouped[cKey] = { course: p.course, topics: {} };
    const tKey = p.topic.id;
    if (!grouped[cKey].topics[tKey]) grouped[cKey].topics[tKey] = { topic: p.topic, week: p.week, courseId: p.course.id, weekId: p.week.id, mats: [] };
    grouped[cKey].topics[tKey].mats.push(p);
  });

  let bodyHtml = '';
  const courseGroups = Object.values(grouped);

  if (!courseGroups.length) {
    bodyHtml = `<div class="pw-empty">
      <div class="pw-empty-icon">${showAll ? '📋' : '✅'}</div>
      <div class="pw-empty-msg">${showAll ? 'Sin materiales registrados aún.' : '¡Todo completado! Sin pendientes.'}</div>
    </div>`;
  } else {
    bodyHtml = courseGroups.map(cg => {
      const topicsHtml = Object.values(cg.topics).map(tg => {
        const matsHtml = tg.mats.map(p => `
          <div class="pw-mat-item${p.done ? ' completed' : ''}"
               data-cid="${p.course.id}" data-wid="${p.week.id}" data-tid="${p.topic.id}" data-mat="${p.matKey}">
            <div class="pw-check${p.done ? ' done' : ''}">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div class="pw-mat-icon">${p.matDef.icon}</div>
            <div class="pw-mat-name">${escHtml(p.matDef.name)}</div>
          </div>`).join('');

        return `<div class="pw-topic-block">
          <div class="pw-topic-name">
            <span>${escHtml(tg.topic.title)}</span>
            <button data-open-topic="${tg.courseId}|${tg.weekId}|${tg.topic.id}">Abrir →</button>
          </div>
          ${matsHtml}
        </div>`;
      }).join('');

      return `<div class="pw-course-group">
        <div class="pw-course-label">
          <div class="pw-course-label-dot" style="background:${cg.course.color}"></div>
          ${escHtml(cg.course.emoji)} ${escHtml(cg.course.name)}
        </div>
        ${topicsHtml}
      </div>`;
    }).join('');
  }

  const badgeClass = pending.length === 0 && total > 0 ? ' done' : '';
  const badgeText = pending.length === 0 && total > 0 ? '✓ Al día' : `${pending.length} pendiente${pending.length !== 1 ? 's' : ''}`;

  const widget = document.createElement('div');
  widget.className = 'pendientes-widget';
  widget.id = 'pendientesWidget';
  widget.innerHTML = `
    <div class="pw-header">
      <div class="pw-title-row">
        <div class="pw-icon">📋</div>
        <div class="pw-title">Pendientes</div>
      </div>
      <span class="pw-count-badge${badgeClass}">${badgeText}</span>
    </div>
    <div class="pw-filter-row">
      <button class="pw-filter-btn${AppState.pendientesFilter === 'pending' ? ' active' : ''}" data-pf="pending">Por hacer</button>
      <button class="pw-filter-btn${AppState.pendientesFilter === 'all' ? ' active' : ''}" data-pf="all">Todos</button>
    </div>
    <div class="pw-body" id="pwBody">${bodyHtml}</div>
    <div class="pw-footer">
      <div class="pw-overall-bar-wrap">
        <div class="pw-overall-bar" style="width:${pct}%"></div>
      </div>
      <div class="pw-footer-meta">
        <div class="pw-footer-text">${doneCount} de ${total} materiales completados</div>
        <div class="pw-footer-pct">${pct}%</div>
      </div>
    </div>`;

  // Filter buttons
  widget.querySelectorAll('.pw-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      AppState.pendientesFilter = btn.dataset.pf;
      renderPendientesWidget();
    });
  });

  // Checkbox clicks — toggle material directly
  widget.querySelectorAll('.pw-mat-item').forEach(item => {
    item.addEventListener('click', () => {
      const { cid, wid, tid, mat } = item.dataset;
      const topic = AppState.getTopic(cid, wid, tid);
      if (!topic) return;
      topic.materials[mat] = !topic.materials[mat];
      AppState.updateTopic(cid, wid, tid, { materials: topic.materials });
      // Refresh widget + panel if open
      renderPendientesWidget();
      if (AppState.activeTopicPath && AppState.activeTopicPath.topicId === tid) {
        renderTopicPanel();
      }
      refreshTopicInView(cid, wid, tid);
      showToast(topic.materials[mat] ? `✓ ${MATERIAL_DEFS.find(m=>m.key===mat)?.name} completado` : 'Marcado como pendiente', topic.materials[mat] ? 'success' : 'info');
    });
  });

  // Open topic links
  widget.querySelectorAll('[data-open-topic]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const [cId, wId, tId] = btn.dataset.openTopic.split('|');
      if (AppState.activeCourseId !== cId) { renderCourseView(cId); showView('courseView'); }
      setTimeout(() => {
        openTopicPanel(cId, wId, tId);
        const wb = document.getElementById(`wb-${wId}`);
        if (wb) wb.classList.add('expanded');
      }, AppState.activeCourseId !== cId ? 120 : 0);
    });
  });

  return widget;
}

function renderPendientesWidget() {
  const grid = document.getElementById('dashMainGrid');
  const old = document.getElementById('pendientesWidget');
  if (old) old.remove();

  const courses = AppState.getFilteredCourses();
  const all = AppState.getAllPendientes(courses);
  if (!all.length) { grid.classList.remove('has-pending'); return; }

  grid.classList.add('has-pending');
  const widget = buildPendientesWidget(courses);
  grid.appendChild(widget);
}

