      <div class="cv-header-right">
        <div><div class="cv-progress-pct">${p}%</div><div class="cv-progress-lbl">Progreso total</div></div>
        <div class="progress-bar-wrap cv-progress-bar-wide"><div class="progress-bar" style="width:${p}%"></div></div>
        <button class="btn-secondary" id="editCourseInView">✏️ Editar</button>
      </div>
    </div>
    <div class="weeks-timeline" id="weeksTimeline"></div>
    <button class="add-week-btn" id="addWeekBtn">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="16" height="16">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
      Agregar Semana ${course.weeks.length + 1}
    </button>`;

  document.getElementById('editCourseInView').addEventListener('click', () => openCourseModal(course));
  document.getElementById('addWeekBtn').addEventListener('click', () => { AppState.addWeek(courseId); renderCourseView(courseId); showToast(`Semana ${course.weeks.length} agregada ✓`, 'success'); });
  renderWeeksTimeline(courseId);
}

function renderWeeksTimeline(courseId) {
  const course = AppState.getCourse(courseId);
  const timeline = document.getElementById('weeksTimeline');
  if (!timeline || !course) return;

  timeline.innerHTML = course.weeks.map((week, wi) => {
    const wp = Calc.weekProgress(week);
    const isAlert = wp < 50 && week.topics.length > 0;
    return `<div class="week-block${isAlert ? ' alert' : ''}${wi === 0 ? ' expanded' : ''}" id="wb-${week.id}">
      <div class="wb-header" data-week-id="${week.id}">
        <div class="wb-number">${week.number}</div>
        <div class="wb-info">
          <div class="wb-title">Semana ${week.number}</div>
          <div class="wb-progress-inline">
            <div class="wb-progress-bar-wrap"><div class="wb-progress-bar" style="width:${wp}%;background:${course.color}"></div></div>
            <div class="wb-progress-pct">${wp}%</div>
            ${isAlert ? '<span class="wb-alert-badge">⚠ Atención</span>' : ''}
            <span class="wb-topics-count">${week.topics.length} tema${week.topics.length !== 1 ? 's' : ''}</span>
          </div>
        </div>
        <svg class="wb-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
      <div class="wb-body">
        <div class="wb-body-inner">
          <div class="topics-list" id="tl-${week.id}">
            ${week.topics.map(t => renderTopicRow(t, courseId, week.id, course.color)).join('')}
            ${!week.topics.length ? '<div style="color:var(--text-3);font-size:12px;padding:10px 0;">Sin temas aún.</div>' : ''}
          </div>
          <button class="wb-add-topic" data-course-id="${courseId}" data-week-id="${week.id}">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="12" height="12">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            Agregar tema
          </button>
          <div class="wb-actions-bar">
            <button class="wb-del-btn" data-del-week="${week.id}" data-course-id="${courseId}">🗑 Eliminar semana</button>
          </div>
        </div>
      </div>
    </div>`;
  }).join('');

  timeline.querySelectorAll('.wb-header').forEach(h => { h.addEventListener('click', () => h.closest('.week-block').classList.toggle('expanded')); });
  timeline.querySelectorAll('.wb-add-topic').forEach(btn => { btn.addEventListener('click', e => { e.stopPropagation(); openTopicModal(btn.dataset.courseId, btn.dataset.weekId); }); });
  timeline.querySelectorAll('[data-del-week]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const w = AppState.getWeek(btn.dataset.courseId, btn.dataset.delWeek);
      openConfirm('¿Eliminar semana?', `Se eliminará la Semana ${w?.number} y todos sus temas.`, () => { AppState.deleteWeek(btn.dataset.courseId, btn.dataset.delWeek); renderCourseView(btn.dataset.courseId); showToast('Semana eliminada', 'error'); });
    });
  });
  timeline.querySelectorAll('.topic-row').forEach(row => { row.addEventListener('click', () => openTopicPanel(row.dataset.courseId, row.dataset.weekId, row.dataset.topicId)); });
}

function renderTopicRow(topic, courseId, weekId, courseColor) {
  const p = Calc.topicProgress(topic);
  const s = Calc.topicStats(topic);
  return `<div class="topic-row" data-course-id="${courseId}" data-week-id="${weekId}" data-topic-id="${topic.id}">
    <div class="topic-priority-dot priority-${topic.priority}"></div>
    <div class="topic-title">${escHtml(topic.title)}</div>
    <div class="topic-progress-area">
      <div class="topic-progress-mini"><div class="topic-progress-fill" style="width:${p}%;background:${courseColor}"></div></div>
      <div class="topic-pct">${p}%</div>
    </div>
    <div class="topic-materials-count">${s.done}/${s.total}</div>
    ${p === 100 ? '<span class="topic-complete-badge">✓</span>' : ''}
  </div>`;
}

/* ============================================================
   TOPIC PANEL
   ============================================================ */
function openTopicPanel(courseId, weekId, topicId) {
  AppState.activeTopicPath = { courseId, weekId, topicId };
  renderTopicPanel();
  document.getElementById('panelOverlay').classList.add('active');
  document.getElementById('topicPanel').classList.add('active');
}

function closeTopicPanel() {
  document.getElementById('panelOverlay').classList.remove('active');
  document.getElementById('topicPanel').classList.remove('active');
  AppState.activeTopicPath = null;
}

document.getElementById('panelOverlay').addEventListener('click', closeTopicPanel);
document.getElementById('tpClose').addEventListener('click', closeTopicPanel);

function renderTopicPanel() {
  const path = AppState.activeTopicPath; if (!path) return;
  const { courseId, weekId, topicId } = path;
  const course = AppState.getCourse(courseId);
  const week = AppState.getWeek(courseId, weekId);
  const topic = AppState.getTopic(courseId, weekId, topicId);
  if (!course || !week || !topic) return;

  const cc = colorClass(course.color);
  document.getElementById('topicPanel').className = `topic-panel active ${cc}`;

  const tag = document.getElementById('tpCourseTag');
  tag.querySelector('span').textContent = `${course.name} › Semana ${week.number}`;
  tag.style.color = course.color;

  document.getElementById('tpTitle').value = topic.title;
  document.getElementById('tpDesc').value = topic.description || '';
  document.getElementById('tpNotes').value = topic.notes || '';
  document.getElementById('tpDate').textContent = topic.updatedAt ? `Actualizado: ${formatDate(topic.updatedAt)}` : '';

  document.querySelectorAll('.priority-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.p === topic.priority));
  updatePanelProgress(topic, course.color);
  renderPendientesInPanel(topic, courseId, weekId, topicId, course.color);
  renderMaterialsList(topic, courseId, weekId, topicId, course.color);

  document.querySelectorAll('.priority-btn').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('.priority-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      AppState.updateTopic(courseId, weekId, topicId, { priority: btn.dataset.p });
      refreshTopicInView(courseId, weekId, topicId);
    };
  });

  let t1, t2, t3;
  document.getElementById('tpTitle').oninput = function() {
    clearTimeout(t1); t1 = setTimeout(() => { AppState.updateTopic(courseId, weekId, topicId, { title: this.value.trim() }); refreshTopicInView(courseId, weekId, topicId); document.getElementById('tpDate').textContent = `Actualizado: ${formatDate(new Date().toISOString())}`; }, 600);
  };
  document.getElementById('tpDesc').oninput = function() {
    clearTimeout(t2); t2 = setTimeout(() => AppState.updateTopic(courseId, weekId, topicId, { description: this.value.trim() }), 600);
  };
  document.getElementById('tpNotes').oninput = function() {
    clearTimeout(t3); t3 = setTimeout(() => { AppState.updateTopic(courseId, weekId, topicId, { notes: this.value }); document.getElementById('tpDate').textContent = `Actualizado: ${formatDate(new Date().toISOString())}`; }, 600);
  };

  document.getElementById('tpDeleteTopic').onclick = () => {
    openConfirm('¿Eliminar tema?', `Se eliminará "${topic.title}".`, () => {
      closeTopicPanel(); AppState.deleteTopic(courseId, weekId, topicId);
      renderCourseView(courseId); showToast('Tema eliminado', 'error');
    });
  };
}

/* ── PENDIENTES in topic panel ── */
function renderPendientesInPanel(topic, courseId, weekId, topicId, courseColor) {
  const section = document.getElementById('tpPendientesSection');
  const list = document.getElementById('tpPendientesList');
  const badge = document.getElementById('tpPendientesBadge');

  const applicable = MATERIAL_DEFS.filter(m => !topic.applicable || topic.applicable[m.key] !== false);
  const pending = applicable.filter(m => !topic.materials[m.key]);
  const done = applicable.filter(m => topic.materials[m.key]);

  badge.textContent = pending.length === 0 ? '✓ Listo' : `${pending.length} por hacer`;
  badge.className = `tp-pendientes-badge${pending.length === 0 ? ' all-done' : ''}`;

  if (!applicable.length) {
    list.innerHTML = '<div style="padding:10px 4px;font-size:11px;color:var(--text-3);">Sin materiales activos en este tema.</div>';
    return;
  }

  if (pending.length === 0) {
    list.innerHTML = `<div class="tp-pendientes-all-done">
      <span style="font-size:18px">🎉</span>
      ¡Todos los materiales completados!
    </div>`;
    return;
  }

  // Show pending first, then done (greyed)
  const allItems = [...pending.map(m => ({ m, done: false })), ...done.map(m => ({ m, done: true }))];
  list.innerHTML = allItems.map(({ m, done: isDone }) => `
    <div class="tp-pend-item${isDone ? ' done-item' : ''}" data-mat="${m.key}">
      <div class="tp-pend-check">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <div class="tp-pend-icon">${m.icon}</div>
      <div class="tp-pend-name">${m.name}</div>
    </div>`).join('');

  list.querySelectorAll('.tp-pend-item').forEach(item => {
    item.addEventListener('click', () => {
      const key = item.dataset.mat;
      topic.materials[key] = !topic.materials[key];
      AppState.updateTopic(courseId, weekId, topicId, { materials: topic.materials });
      updatePanelProgress(topic, courseColor);
      renderPendientesInPanel(topic, courseId, weekId, topicId, courseColor);
      renderMaterialsList(topic, courseId, weekId, topicId, courseColor);
      refreshTopicInView(courseId, weekId, topicId);
      // Also refresh dashboard widget if visible
      if (document.getElementById('pendientesWidget')) renderPendientesWidget();
      showToast(topic.materials[key] ? `✓ ${MATERIAL_DEFS.find(m=>m.key===key)?.name} completado` : 'Marcado como pendiente', topic.materials[key] ? 'success' : 'info');
    });
  });
}

function renderMaterialsList(topic, courseId, weekId, topicId, courseColor) {
  const list = document.getElementById('materialsList');
  list.innerHTML = MATERIAL_DEFS.map(m => {
    const checked = topic.materials[m.key];
    const applicable = topic.applicable ? topic.applicable[m.key] !== false : true;
    return `<div class="material-item${applicable ? '' : ' not-applicable'}" id="mi-${m.key}">
      <div class="material-check${checked && applicable ? ' checked' : ''}" data-mat="${m.key}" style="${checked && applicable ? `--cc:${courseColor};--cc-dim:${courseColor}20` : ''}">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      </div>
      <div class="material-icon">${m.icon}</div>
      <div class="material-name">${m.name}</div>
      <div class="material-applicable-toggle${applicable ? ' on' : ''}" data-toggle="${m.key}"></div>
    </div>`;
  }).join('');

  list.querySelectorAll('.material-check').forEach(chk => {
    chk.addEventListener('click', () => {
      const key = chk.dataset.mat;
      const applicable = topic.applicable ? topic.applicable[key] !== false : true;
      if (!applicable) return;
      topic.materials[key] = !topic.materials[key];
      const nv = topic.materials[key];
      chk.classList.toggle('checked', nv);
      nv ? (chk.style.setProperty('--cc', courseColor), chk.style.setProperty('--cc-dim', courseColor+'20')) : (chk.style.removeProperty('--cc'), chk.style.removeProperty('--cc-dim'));
      AppState.updateTopic(courseId, weekId, topicId, { materials: topic.materials });
      updatePanelProgress(topic, courseColor);
      renderPendientesInPanel(topic, courseId, weekId, topicId, courseColor);
      refreshTopicInView(courseId, weekId, topicId);
      if (document.getElementById('pendientesWidget')) renderPendientesWidget();
    });
  });

  list.querySelectorAll('.material-applicable-toggle').forEach(tog => {
    tog.addEventListener('click', () => {
      const key = tog.dataset.toggle;
      if (!topic.applicable) topic.applicable = {};
      topic.applicable[key] = topic.applicable[key] === false;
      if (!topic.applicable[key]) topic.materials[key] = false;
      AppState.updateTopic(courseId, weekId, topicId, { materials: topic.materials, applicable: topic.applicable });
      renderMaterialsList(topic, courseId, weekId, topicId, courseColor);
      renderPendientesInPanel(topic, courseId, weekId, topicId, courseColor);
      updatePanelProgress(topic, courseColor);
      refreshTopicInView(courseId, weekId, topicId);
      if (document.getElementById('pendientesWidget')) renderPendientesWidget();
    });
  });
}

function updatePanelProgress(topic, courseColor) {
  const p = Calc.topicProgress(topic);
  const s = Calc.topicStats(topic);
  document.getElementById('tpProgressPct').textContent = p + '%';
  document.getElementById('tpProgressPct').style.color = courseColor;
  document.getElementById('tpProgressBar').style.width = p + '%';
  document.getElementById('tpProgressSub').textContent = `${s.done} de ${s.total} materiales completados`;
}

function refreshTopicInView(courseId, weekId, topicId) {
  const topic = AppState.getTopic(courseId, weekId, topicId);
  const course = AppState.getCourse(courseId);
  const rowEl = document.querySelector(`.topic-row[data-topic-id="${topicId}"]`);
  if (rowEl && topic && course) {
    const tmp = document.createElement('div');
    tmp.innerHTML = renderTopicRow(topic, courseId, weekId, course.color);
    const newRow = tmp.firstElementChild;
    newRow.addEventListener('click', () => openTopicPanel(courseId, weekId, topicId));
    rowEl.replaceWith(newRow);
  }
  const week = AppState.getWeek(courseId, weekId);
  if (week) {
    const wp = Calc.weekProgress(week);
    const bar = document.querySelector(`#wb-${weekId} .wb-progress-bar`);
    const pct = document.querySelector(`#wb-${weekId} .wb-progress-pct`);
    if (bar) bar.style.width = wp + '%';
    if (pct) pct.textContent = wp + '%';
  }
  const cp = Calc.courseProgress(course);
  const cpBar = document.getElementById('courseProgressBar');
  const cpPct = document.getElementById('courseProgressPct');
  if (cpBar) cpBar.style.width = cp + '%';
  if (cpPct) cpPct.textContent = cp + '%';
}

/* ============================================================
   NAVIGATION
   ============================================================ */
document.getElementById('addCourseBtn').addEventListener('click', () => openCourseModal());
document.getElementById('dashLogo').addEventListener('click', () => { renderDashboard(); showView('dashboard'); });
document.getElementById('cvLogo').addEventListener('click', () => { renderDashboard(); showView('dashboard'); });
document.getElementById('backToDash').addEventListener('click', () => { AppState.activeCourseId = null; closeTopicPanel(); renderDashboard(); showView('dashboard'); });

/* ============================================================
   SEARCH
   ============================================================ */
document.getElementById('searchInput').addEventListener('input', function() {
  const q = this.value.trim().toLowerCase();
  const dd = document.getElementById('searchDropdown');
  if (!q) { dd.classList.remove('visible'); dd.innerHTML = ''; return; }
  const results = [];
  AppState.courses.forEach(c => { c.weeks.forEach(w => { w.topics.forEach(t => { if (t.title.toLowerCase().includes(q)) results.push({ courseId: c.id, weekId: w.id, topicId: t.id, courseName: c.name, weekNum: w.number, topicTitle: t.title }); }); }); });
  if (!results.length) { dd.innerHTML = '<div class="search-result"><span class="sr-topic" style="color:var(--text-3)">Sin resultados</span></div>'; }
  else { dd.innerHTML = results.slice(0,8).map(r => { const hl = r.topicTitle.replace(new RegExp(q,'gi'), m => `<span class="sr-highlight">${m}</span>`); return `<div class="search-result" data-cid="${r.courseId}" data-wid="${r.weekId}" data-tid="${r.topicId}"><span class="sr-topic">${hl}</span><span class="sr-path">${escHtml(r.courseName)} › Semana ${r.weekNum}</span></div>`; }).join(''); }
  dd.classList.add('visible');
  dd.querySelectorAll('.search-result[data-cid]').forEach(el => {
    el.addEventListener('click', () => {
      dd.classList.remove('visible'); document.getElementById('searchInput').value = '';
      const cId = el.dataset.cid;
      if (AppState.activeCourseId !== cId) { renderCourseView(cId); showView('courseView'); }
      setTimeout(() => { openTopicPanel(cId, el.dataset.wid, el.dataset.tid); const wb = document.getElementById(`wb-${el.dataset.wid}`); if (wb) wb.classList.add('expanded'); }, 100);
    });
  });
});

document.addEventListener('click', e => {
  if (!document.getElementById('searchInput').contains(e.target) && !document.getElementById('searchDropdown').contains(e.target))
    document.getElementById('searchDropdown').classList.remove('visible');
});

/* ============================================================
   COUNT-UP
   ============================================================ */
function animateNumber(el, target, suffix='') {
  const start = parseInt(el.textContent) || 0;
  const dur = 600; const t0 = performance.now();
  (function step(now) {
    const p = Math.min((now - t0) / dur, 1);
    el.textContent = Math.round(start + (target - start) * (1 - Math.pow(1 - p, 3))) + suffix;
    if (p < 1) requestAnimationFrame(step);
  })(performance.now());
}

/* ============================================================
   KEYBOARD
   ============================================================ */
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    if (document.getElementById('topicPanel').classList.contains('active')) { closeTopicPanel(); return; }
    const m = document.querySelector('.modal-overlay.active');
    if (m) m.classList.remove('active');
  }
});

/* ============================================================
   BOOT
   ============================================================ */
function boot() {
  AppState.init();
  if (!AppState.courses.length) showView('onboarding');
  else { renderDashboard(); showView('dashboard'); }
}

boot();
</script>
