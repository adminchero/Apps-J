<script>
/* ============================================================
   CONSTANTS
   ============================================================ */
const MATERIAL_DEFS = [
  { key: 'resumen_pdf',         icon: '📄', name: 'Resumen PDF' },
  { key: 'cuestionario',        icon: '❓', name: 'Cuestionario IA' },
  { key: 'fichero',             icon: '🗂️', name: 'Fichero / fichas' },
  { key: 'mapa_conceptual',     icon: '🧠', name: 'Mapa conceptual' },
  { key: 'flashcards',          icon: '🃏', name: 'Flashcards' },
  { key: 'practica_ejercicios', icon: '✏️', name: 'Práctica / ejercicios' },
  { key: 'notas_propias',       icon: '📝', name: 'Notas propias' },
  { key: 'video_repaso',        icon: '🎥', name: 'Video de repaso' },
];

const COURSE_COLORS = ['#6C63FF','#00E5CC','#FF6B6B','#FFB547','#3EE0A0','#FF7EB3','#5BA8FF','#C4A1FF'];
const COURSE_EMOJIS = ['📚','🧮','💻','🔬','🧬','📐','🏛️','🎯','🧪','📊','🌐','⚗️'];
const COLOR_CLASS   = ['c0','c1','c2','c3','c4','c5','c6','c7'];
const LS_KEY   = 'studium_courses';
const LS_PREFS = 'studium_prefs';

/* ============================================================
   DATA LAYER
   ============================================================ */
const DataLayer = {
  load() { try { const r = localStorage.getItem(LS_KEY); return r ? JSON.parse(r) : []; } catch(e) { return []; } },
  save(c) { try { localStorage.setItem(LS_KEY, JSON.stringify(c)); } catch(e) {} },
  loadPrefs() { try { const r = localStorage.getItem(LS_PREFS); return r ? JSON.parse(r) : { streak:0, lastStreakDate:null }; } catch(e) { return { streak:0, lastStreakDate:null }; } },
  savePrefs(p) { try { localStorage.setItem(LS_PREFS, JSON.stringify(p)); } catch(e) {} }
};

/* ============================================================
   APP STATE
   ============================================================ */
const AppState = {
  courses: [],
  prefs: {},
  activeCourseId: null,
  activeTopicPath: null,
  activeSemesterFilter: 'all',
  pendientesFilter: 'pending', // 'pending' | 'all'

  init() {
    this.courses = DataLayer.load();
    this.prefs = DataLayer.loadPrefs();
    this.updateStreak();
  },

  updateStreak() {
    const today = new Date().toDateString();
    const yesterday = new Date(Date.now() - 86400000).toDateString();
    if (this.prefs.lastStreakDate === today) return;
    if (this.prefs.lastStreakDate === yesterday) this.prefs.streak = (this.prefs.streak || 0) + 1;
    else this.prefs.streak = 1;
    this.prefs.lastStreakDate = today;
    DataLayer.savePrefs(this.prefs);
  },

  saveCourses() { DataLayer.save(this.courses); },
  getSemesters() { const s = new Set(); this.courses.forEach(c => { if (c.semester) s.add(c.semester); }); return [...s].sort().reverse(); },
  getFilteredCourses() { if (this.activeSemesterFilter === 'all') return this.courses; return this.courses.filter(c => c.semester === this.activeSemesterFilter); },
  getCourse(id) { return this.courses.find(c => c.id === id); },
  getWeek(cId, wId) { const c = this.getCourse(cId); return c ? c.weeks.find(w => w.id === wId) : null; },
  getTopic(cId, wId, tId) { const w = this.getWeek(cId, wId); return w ? w.topics.find(t => t.id === tId) : null; },

  addCourse(data) { const c = { id: uid(), name: data.name, color: data.color, emoji: data.emoji, semester: data.semester, weeks: [] }; this.courses.push(c); this.saveCourses(); return c; },
  updateCourse(id, data) { const c = this.getCourse(id); if (!c) return; Object.assign(c, data); this.saveCourses(); },
  deleteCourse(id) { this.courses = this.courses.filter(c => c.id !== id); this.saveCourses(); },

  addWeek(cId) { const c = this.getCourse(cId); if (!c) return null; const w = { id: uid(), number: c.weeks.length + 1, topics: [] }; c.weeks.push(w); this.saveCourses(); return w; },
  deleteWeek(cId, wId) { const c = this.getCourse(cId); if (!c) return; c.weeks = c.weeks.filter(w => w.id !== wId); c.weeks.forEach((w,i) => w.number = i+1); this.saveCourses(); },

  addTopic(cId, wId, data) {
    const w = this.getWeek(cId, wId); if (!w) return null;
    const defaultM = {}, defaultA = {};
    MATERIAL_DEFS.forEach(m => { defaultM[m.key] = false; defaultA[m.key] = true; });
    const t = { id: uid(), title: data.title, description: data.description || '', materials: defaultM, applicable: defaultA, notes: '', priority: 'media', updatedAt: new Date().toISOString() };
    w.topics.push(t); this.saveCourses(); return t;
  },
  deleteTopic(cId, wId, tId) { const w = this.getWeek(cId, wId); if (!w) return; w.topics = w.topics.filter(t => t.id !== tId); this.saveCourses(); },
  updateTopic(cId, wId, tId, data) { const t = this.getTopic(cId, wId, tId); if (!t) return; Object.assign(t, data); t.updatedAt = new Date().toISOString(); this.saveCourses(); },

  exportJSON() { return JSON.stringify(this.courses, null, 2); },
  importJSON(s) { const p = JSON.parse(s); if (!Array.isArray(p)) throw new Error('Formato inválido'); this.courses = p; this.saveCourses(); },

  /* ── PENDIENTES HELPERS ── */
  getAllPendientes(coursesFilter) {
    // Returns flat list of { course, week, topic, matKey, matDef, done }
    const result = [];
    const courses = coursesFilter || this.getFilteredCourses();
    courses.forEach(c => {
      c.weeks.forEach(w => {
        w.topics.forEach(t => {
          MATERIAL_DEFS.forEach(m => {
            const applicable = !t.applicable || t.applicable[m.key] !== false;
            if (!applicable) return;
            result.push({
              course: c, week: w, topic: t,
              matKey: m.key, matDef: m,
              done: !!t.materials[m.key]
            });
          });
        });
      });
    });
    return result;
  }
};

/* ============================================================
   CALC
   ============================================================ */
const Calc = {
  topicProgress(t) {
    if (!t.applicable) return 0;
    const ap = MATERIAL_DEFS.filter(m => t.applicable[m.key] !== false);
    if (!ap.length) return 0;
    return Math.round(ap.filter(m => t.materials[m.key]).length / ap.length * 100);
  },
  topicStats(t) {
    if (!t.applicable) return { done:0, total:0 };
    const ap = MATERIAL_DEFS.filter(m => t.applicable[m.key] !== false);
    return { done: ap.filter(m => t.materials[m.key]).length, total: ap.length };
  },
  weekProgress(w) { if (!w.topics.length) return 0; return Math.round(w.topics.reduce((a,t) => a + this.topicProgress(t), 0) / w.topics.length); },
  courseProgress(c) { const all = c.weeks.flatMap(w => w.topics); if (!all.length) return 0; return Math.round(all.reduce((a,t) => a + this.topicProgress(t), 0) / all.length); },
  globalProgress(cs) { if (!cs.length) return 0; return Math.round(cs.reduce((a,c) => a + this.courseProgress(c), 0) / cs.length); },
  totalTopics(cs) { return cs.reduce((a,c) => a + c.weeks.reduce((b,w) => b + w.topics.length, 0), 0); },
  completedTopics(cs) { let n=0; cs.forEach(c => c.weeks.forEach(w => w.topics.forEach(t => { if (this.topicProgress(t)===100) n++; }))); return n; },
  materialUsage(cs) { const u={}; MATERIAL_DEFS.forEach(m => u[m.key]=0); cs.forEach(c => c.weeks.forEach(w => w.topics.forEach(t => { MATERIAL_DEFS.forEach(m => { if (t.materials[m.key]) u[m.key]++; }); }))); return u; }
};

