  const list = document.getElementById('courseComparisonList');
  if (!courses.length) { list.innerHTML = '<div style="color:var(--text-3);font-size:12px;">Sin cursos.</div>'; }
  else { list.innerHTML = courses.map(c => { const p = Calc.courseProgress(c); return `<div class="course-comparison-row"><div class="ccr-name">${escHtml(c.emoji)} ${escHtml(c.name)}</div><div class="ccr-bar-wrap"><div class="ccr-bar" style="width:${p}%;background:${c.color}"></div></div><div class="ccr-pct">${p}%</div></div>`; }).join(''); }
  const usage = Calc.materialUsage(courses);
