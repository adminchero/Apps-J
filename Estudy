<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>STUDIUM — Tu Registro Académico</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=JetBrains+Mono:wght@300;400;500;600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ============================================================
   DESIGN SYSTEM
   ============================================================ */
:root {
  --bg:           #0A0C10;
  --surface:      #111318;
  --surface-el:   #181C24;
  --surface-hi:   #1E2230;
  --border:       rgba(255,255,255,0.07);
  --border-md:    rgba(255,255,255,0.12);
  --accent:       #6C63FF;
  --accent-dim:   rgba(108,99,255,0.15);
  --accent-glow:  rgba(108,99,255,0.4);
  --teal:         #00E5CC;
  --teal-dim:     rgba(0,229,204,0.12);
  --warning:      #FFB547;
  --danger:       #FF4D6D;
  --success:      #3EE0A0;
  --text-1:       #EDF0F7;
  --text-2:       #8892A4;
  --text-3:       #3D4557;
  --font-display: 'Playfair Display', Georgia, serif;
  --font-mono:    'JetBrains Mono', monospace;
  --font-ui:      'Outfit', sans-serif;
  --radius-sm:    6px;
  --radius-md:    10px;
  --radius-lg:    16px;
  --radius-xl:    24px;
  --shadow-sm:    0 2px 8px rgba(0,0,0,0.4);
  --shadow-md:    0 8px 32px rgba(0,0,0,0.5);
  --shadow-lg:    0 16px 64px rgba(0,0,0,0.6);
  --transition:   all 0.25s cubic-bezier(0.4,0,0.2,1);
  --header-h:     60px;
}

.c0 { --cc: #6C63FF; --cc-dim: rgba(108,99,255,0.12); }
.c1 { --cc: #00E5CC; --cc-dim: rgba(0,229,204,0.10); }
.c2 { --cc: #FF6B6B; --cc-dim: rgba(255,107,107,0.12); }
.c3 { --cc: #FFB547; --cc-dim: rgba(255,181,71,0.12); }
.c4 { --cc: #3EE0A0; --cc-dim: rgba(62,224,160,0.12); }
.c5 { --cc: #FF7EB3; --cc-dim: rgba(255,126,179,0.12); }
.c6 { --cc: #5BA8FF; --cc-dim: rgba(91,168,255,0.12); }
.c7 { --cc: #C4A1FF; --cc-dim: rgba(196,161,255,0.12); }

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 16px; scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text-1);
  font-family: var(--font-ui);
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
button { cursor: pointer; border: none; background: none; font-family: inherit; color: inherit; }
input, textarea, select { font-family: var(--font-ui); outline: none; }
a { text-decoration: none; color: inherit; }

::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--text-3); border-radius: 3px; }

#app { min-height: 100vh; }
.view { display: none; }
.view.active { display: block; }

/* ============================================================
   GLOBAL HEADER
   ============================================================ */
.global-header {
  position: sticky; top: 0; z-index: 100;
  background: rgba(10,12,16,0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  height: var(--header-h);
  display: flex; align-items: center; gap: 0; padding: 0;
}

.gh-left {
  display: flex; align-items: center; gap: 16px;
  padding: 0 20px; border-right: 1px solid var(--border);
  height: 100%; flex-shrink: 0;
}

.gh-logo {
  font-family: var(--font-display);
  font-size: 20px; font-weight: 700; letter-spacing: -0.5px;
  background: linear-gradient(135deg, var(--text-1) 0%, var(--accent) 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; cursor: pointer; user-select: none;
}

.gh-back {
  display: flex; align-items: center; gap: 6px;
  font-size: 12px; color: var(--text-2);
  padding: 6px 10px; border-radius: var(--radius-sm);
  border: 1px solid var(--border); transition: var(--transition); flex-shrink: 0;
}
.gh-back:hover { color: var(--text-1); border-color: var(--border-md); background: var(--surface-el); }
.gh-back svg { width: 12px; height: 12px; }

.gh-center {
  flex: 1; padding: 0 20px;
  display: flex; align-items: center; gap: 16px;
}

.gh-search { flex: 1; max-width: 360px; position: relative; }
.gh-search input {
  width: 100%; background: var(--surface-el);
  border: 1px solid var(--border); border-radius: var(--radius-md);
  padding: 8px 14px 8px 36px; font-size: 13px; color: var(--text-1); transition: var(--transition);
}
.gh-search input::placeholder { color: var(--text-3); }
.gh-search input:focus { border-color: var(--accent); background: var(--surface-hi); }
.gh-search svg { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-3); width: 14px; height: 14px; pointer-events: none; }

.gh-progress-compact { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.gh-progress-bar-wrap { width: 120px; height: 4px; background: var(--surface-hi); border-radius: 2px; overflow: hidden; }
.gh-progress-bar { height: 100%; border-radius: 2px; background: linear-gradient(90deg, var(--accent), var(--teal)); transition: width 0.8s cubic-bezier(0.4,0,0.2,1); }
.gh-progress-pct { font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--text-2); min-width: 34px; text-align: right; }

.gh-right {
  display: flex; align-items: center; gap: 8px;
  padding: 0 16px; border-left: 1px solid var(--border); height: 100%; flex-shrink: 0;
}

/* ============================================================
   BUTTON SYSTEM
   ============================================================ */
.btn-primary {
  display: inline-flex; align-items: center; gap: 7px;
  background: var(--accent); color: #fff;
  font-size: 13px; font-weight: 600;
  padding: 9px 18px; border-radius: var(--radius-md);
  transition: var(--transition); box-shadow: 0 0 20px var(--accent-dim); white-space: nowrap;
}
.btn-primary:hover { background: #7B73FF; box-shadow: 0 0 30px var(--accent-glow); transform: translateY(-1px); }
.btn-primary svg { width: 14px; height: 14px; }

.btn-secondary {
  display: inline-flex; align-items: center; gap: 7px;
  background: var(--surface-el); color: var(--text-2);
  font-size: 12px; font-weight: 500;
  padding: 8px 14px; border-radius: var(--radius-md);
  border: 1px solid var(--border); transition: var(--transition); white-space: nowrap;
}
.btn-secondary:hover { color: var(--text-1); border-color: var(--border-md); background: var(--surface-hi); }
.btn-secondary svg { width: 13px; height: 13px; }

.btn-ghost {
  display: inline-flex; align-items: center; gap: 6px;
  color: var(--text-2); font-size: 12px; font-weight: 500;
  padding: 7px 12px; border-radius: var(--radius-sm);
  transition: var(--transition); white-space: nowrap;
}
.btn-ghost:hover { color: var(--text-1); background: var(--surface-el); }
.btn-ghost svg { width: 13px; height: 13px; }

/* ============================================================
   ONBOARDING
   ============================================================ */
#onboarding {
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  position: relative; overflow: hidden;
}

.ob-bg {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 60% 40% at 20% 30%, rgba(108,99,255,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 40% 60% at 80% 70%, rgba(0,229,204,0.06) 0%, transparent 60%);
}

.ob-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(var(--border) 1px, transparent 1px),
    linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 0%, transparent 100%);
}

.ob-card {
  position: relative; z-index: 2;
  background: var(--surface); border: 1px solid var(--border-md);
  border-radius: var(--radius-xl); padding: 56px 64px;
  text-align: center; max-width: 480px;
  box-shadow: var(--shadow-lg), 0 0 80px rgba(108,99,255,0.08);
  animation: obIn 0.7s cubic-bezier(0.34,1.56,0.64,1) both;
}

@keyframes obIn {
  from { opacity: 0; transform: translateY(24px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.ob-wordmark {
  font-family: var(--font-display);
  font-size: 72px; font-weight: 900;
  letter-spacing: -3px; line-height: 1;
  background: linear-gradient(135deg, #EDF0F7 0%, #6C63FF 55%, #00E5CC 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; margin-bottom: 14px;
}

.ob-tagline {
  font-family: var(--font-mono);
  font-size: 11px; letter-spacing: 3px;
  text-transform: uppercase; color: var(--text-3); margin-bottom: 36px;
}
.ob-tagline em { color: var(--accent); font-style: normal; }

.ob-actions { display: flex; flex-direction: column; gap: 12px; }

.ob-cta {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  background: var(--accent); color: #fff;
  font-size: 14px; font-weight: 600;
  padding: 16px 32px; border-radius: var(--radius-lg);
  box-shadow: 0 0 40px var(--accent-glow); transition: var(--transition);
}
.ob-cta:hover { transform: translateY(-2px); box-shadow: 0 0 60px var(--accent-glow); background: #7B73FF; }

.ob-import-hint { font-size: 12px; color: var(--text-3); }
.ob-import-link { color: var(--accent); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
.ob-import-link:hover { color: var(--teal); }

/* ============================================================
   DASHBOARD
   ============================================================ */
.dashboard { max-width: 1400px; margin: 0 auto; padding: 32px 28px; }

.dash-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 28px; gap: 20px; flex-wrap: wrap;
}

.dash-title { font-family: var(--font-display); font-size: 40px; font-weight: 700; letter-spacing: -1.5px; line-height: 1; color: var(--text-1); }
.dash-subtitle { font-size: 12px; color: var(--text-2); margin-top: 6px; font-family: var(--font-mono); letter-spacing: 1px; }

.dash-controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

.semester-filter {
  display: flex; align-items: center;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-md); overflow: hidden;
}
.sf-btn {
  padding: 7px 14px; font-size: 12px; font-weight: 500;
  color: var(--text-2); transition: var(--transition);
  border-right: 1px solid var(--border);
}
.sf-btn:last-child { border-right: none; }
.sf-btn.active { background: var(--accent); color: #fff; }
.sf-btn:hover:not(.active) { background: var(--surface-el); color: var(--text-1); }

/* ============================================================
   STATS STRIP
   ============================================================ */
.stats-strip {
  display: grid; grid-template-columns: repeat(5, 1fr);
  gap: 2px; margin-bottom: 28px;
  background: var(--border); border: 1px solid var(--border);
  border-radius: var(--radius-lg); overflow: hidden;
}

.stat-block { background: var(--surface); padding: 18px 20px; position: relative; transition: background 0.2s ease; }
.stat-block:hover { background: var(--surface-el); }
.stat-block-val { font-family: var(--font-mono); font-size: 26px; font-weight: 600; color: var(--text-1); margin-bottom: 4px; display: flex; align-items: baseline; gap: 4px; }
.stat-block-val .unit { font-size: 13px; color: var(--text-2); font-weight: 400; }
.stat-block-lbl { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-3); }

/* ============================================================
   DASHBOARD LAYOUT — two-column when pendientes exist
   ============================================================ */
.dash-main-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  margin-bottom: 40px;
}
.dash-main-grid.has-pending {
  grid-template-columns: 1fr 340px;
  align-items: start;
}

/* ============================================================
   COURSE GRID
   ============================================================ */
.course-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
}

.course-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 24px;
  cursor: pointer; position: relative; overflow: hidden;
  transition: transform 0.3s cubic-bezier(0.4,0,0.2,1), box-shadow 0.3s ease, border-color 0.3s ease;
  animation: cardFadeUp 0.4s cubic-bezier(0.4,0,0.2,1) both;
}
@keyframes cardFadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
.course-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--cc, var(--accent)); opacity: 0; transition: opacity 0.3s ease;
}
.course-card:hover { transform: translateY(-3px); border-color: var(--cc, var(--accent)); box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 0 0 1px var(--cc, var(--accent)), 0 0 32px var(--cc-dim, var(--accent-dim)); }
.course-card:hover::before { opacity: 1; }

.cc-bg-accent { position: absolute; top: -40px; right: -40px; width: 140px; height: 140px; background: var(--cc-dim, var(--accent-dim)); border-radius: 50%; pointer-events: none; }

.cc-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px; }
.cc-emoji { font-size: 28px; line-height: 1; }

.cc-actions { display: flex; gap: 4px; opacity: 0; transition: opacity 0.2s ease; }
.course-card:hover .cc-actions { opacity: 1; }

.cc-action-btn { width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); color: var(--text-2); transition: var(--transition); }
.cc-action-btn:hover { background: var(--surface-hi); color: var(--text-1); }
.cc-action-btn.danger:hover { background: rgba(255,77,109,0.15); color: var(--danger); }
.cc-action-btn svg { width: 13px; height: 13px; }

.cc-name { font-family: var(--font-display); font-size: 22px; font-weight: 700; letter-spacing: -0.5px; color: var(--text-1); margin-bottom: 4px; line-height: 1.2; }
.cc-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
.cc-semester { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--text-3); text-transform: uppercase; }
.cc-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--text-3); }
.cc-weeks { font-family: var(--font-mono); font-size: 10px; color: var(--text-3); }

.cc-progress-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
.cc-progress-label { font-size: 10px; color: var(--text-3); text-transform: uppercase; letter-spacing: 1px; }
.cc-progress-pct { font-family: var(--font-mono); font-size: 18px; font-weight: 600; color: var(--cc, var(--accent)); }

.progress-bar-wrap { height: 4px; background: var(--surface-el); border-radius: 2px; overflow: hidden; margin-bottom: 14px; }
.progress-bar {
  height: 100%; border-radius: 2px;
  background: linear-gradient(90deg, var(--cc, var(--accent)), color-mix(in srgb, var(--cc, var(--accent)) 60%, var(--teal)));
  transition: width 0.8s cubic-bezier(0.4,0,0.2,1);
}

.cc-stats { display: flex; gap: 16px; }
.cc-stat { display: flex; flex-direction: column; gap: 2px; }
.cc-stat-val { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--text-1); }
.cc-stat-lbl { font-size: 10px; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.8px; }

.empty-state { grid-column: 1 / -1; text-align: center; padding: 80px 40px; }
.empty-state-icon { font-size: 56px; margin-bottom: 16px; opacity: 0.35; }
.empty-state-title { font-family: var(--font-display); font-size: 22px; font-weight: 600; color: var(--text-2); margin-bottom: 6px; }
.empty-state-text { font-size: 13px; color: var(--text-3); margin-bottom: 20px; }

/* ============================================================
   PENDIENTES WIDGET — sidebar panel in dashboard
   ============================================================ */
.pendientes-widget {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: sticky;
  top: calc(var(--header-h) + 16px);
  max-height: calc(100vh - var(--header-h) - 48px);
  display: flex;
  flex-direction: column;
}

.pw-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 20px 14px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.pw-title-row {
  display: flex; align-items: center; gap: 10px;
}

.pw-icon {
  width: 32px; height: 32px; border-radius: var(--radius-sm);
  background: rgba(255,181,71,0.12);
  border: 1px solid rgba(255,181,71,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; flex-shrink: 0;
}

.pw-title {
  font-family: var(--font-display);
  font-size: 16px; font-weight: 700;
  letter-spacing: -0.3px; color: var(--text-1);
}

.pw-count-badge {
  font-family: var(--font-mono);
  font-size: 10px; font-weight: 600;
  background: rgba(255,181,71,0.15);
  color: var(--warning);
  border: 1px solid rgba(255,181,71,0.25);
  padding: 2px 7px; border-radius: 20px;
  transition: var(--transition);
}

.pw-count-badge.done { background: rgba(62,224,160,0.1); color: var(--success); border-color: rgba(62,224,160,0.25); }

.pw-filter-row {
  display: flex; gap: 4px; padding: 10px 20px 0;
  flex-shrink: 0;
}
.pw-filter-btn {
  flex: 1; padding: 5px 8px; font-size: 10px; font-weight: 600;
  border-radius: var(--radius-sm); border: 1px solid var(--border);
  color: var(--text-3); background: var(--surface-el);
  transition: var(--transition); letter-spacing: 0.5px; text-transform: uppercase;
}
.pw-filter-btn.active { background: var(--surface-hi); color: var(--text-1); border-color: var(--border-md); }
.pw-filter-btn:hover:not(.active) { color: var(--text-2); border-color: var(--border-md); }

.pw-body {
  flex: 1; overflow-y: auto;
  padding: 12px 20px 16px;
}

.pw-empty {
  text-align: center; padding: 32px 16px;
  color: var(--text-3); font-size: 12px;
}
.pw-empty-icon { font-size: 32px; margin-bottom: 10px; opacity: 0.5; }
.pw-empty-msg { line-height: 1.5; }

.pw-course-group { margin-bottom: 16px; }
.pw-course-group:last-child { margin-bottom: 0; }

.pw-course-label {
  display: flex; align-items: center; gap: 6px;
  font-size: 10px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 1px;
  color: var(--text-3); margin-bottom: 8px;
  padding-bottom: 6px; border-bottom: 1px solid var(--border);
}
.pw-course-label-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }

.pw-topic-block { margin-bottom: 10px; }
.pw-topic-block:last-child { margin-bottom: 0; }

.pw-topic-name {
  font-size: 11px; font-weight: 600; color: var(--text-2);
  margin-bottom: 5px; padding-left: 2px;
  display: flex; align-items: center; justify-content: space-between;
}
.pw-topic-name button {
  font-size: 10px; color: var(--accent);
  opacity: 0; transition: opacity 0.2s ease;
  text-decoration: underline; text-underline-offset: 2px;
}
.pw-topic-block:hover .pw-topic-name button { opacity: 1; }

.pw-mat-item {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 10px;
  background: var(--surface-el); border: 1px solid var(--border);
  border-radius: var(--radius-sm); margin-bottom: 4px;
  cursor: pointer; transition: var(--transition);
}
.pw-mat-item:last-child { margin-bottom: 0; }
.pw-mat-item:hover { border-color: var(--border-md); background: var(--surface-hi); }

.pw-mat-item.completed {
  opacity: 0.5;
  background: rgba(62,224,160,0.04);
  border-color: rgba(62,224,160,0.12);
}
.pw-mat-item.completed .pw-mat-name { text-decoration: line-through; color: var(--text-3); }

.pw-check {
  width: 16px; height: 16px; border-radius: 4px;
  border: 2px solid var(--border-md);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1);
}
.pw-check.done {
  background: var(--success); border-color: var(--success);
  transform: scale(1.1);
  box-shadow: 0 0 8px rgba(62,224,160,0.3);
}
.pw-check svg { opacity: 0; width: 8px; height: 8px; transition: opacity 0.15s ease; }
.pw-check.done svg { opacity: 1; }

.pw-mat-icon { font-size: 11px; line-height: 1; flex-shrink: 0; }
.pw-mat-name { font-size: 11px; color: var(--text-1); flex: 1; line-height: 1.3; }

.pw-footer {
  padding: 12px 20px;
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}
.pw-overall-bar-wrap { height: 3px; background: var(--surface-hi); border-radius: 2px; overflow: hidden; margin-bottom: 6px; }
.pw-overall-bar { height: 100%; border-radius: 2px; background: linear-gradient(90deg, var(--accent), var(--teal)); transition: width 0.6s cubic-bezier(0.4,0,0.2,1); }
.pw-footer-meta { display: flex; justify-content: space-between; align-items: center; }
.pw-footer-text { font-size: 10px; color: var(--text-3); }
.pw-footer-pct { font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--text-2); }

/* ============================================================
   ANALYSIS SECTION
   ============================================================ */
.stats-section { margin-top: 8px; }
.stats-title { font-family: var(--font-display); font-size: 26px; font-weight: 700; letter-spacing: -0.5px; color: var(--text-1); margin-bottom: 20px; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.stats-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; }
.stats-card-title { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-3); margin-bottom: 18px; font-weight: 600; }
.course-comparison-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.course-comparison-row:last-child { margin-bottom: 0; }
.ccr-name { width: 80px; font-size: 12px; font-weight: 500; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 0; }
.ccr-bar-wrap { flex: 1; height: 5px; background: var(--surface-el); border-radius: 3px; overflow: hidden; }
.ccr-bar { height: 100%; border-radius: 3px; transition: width 0.8s cubic-bezier(0.4,0,0.2,1); }
.ccr-pct { font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--text-2); min-width: 32px; text-align: right; flex-shrink: 0; }
.material-usage-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.material-usage-row:last-child { margin-bottom: 0; }
.mur-icon { font-size: 13px; width: 20px; text-align: center; flex-shrink: 0; }
.mur-name { flex: 1; font-size: 12px; color: var(--text-2); }
.mur-bar-wrap { width: 80px; height: 4px; background: var(--surface-el); border-radius: 2px; overflow: hidden; flex-shrink: 0; }
.mur-bar { height: 100%; background: var(--accent); border-radius: 2px; }
.mur-count { font-family: var(--font-mono); font-size: 11px; color: var(--text-3); min-width: 20px; text-align: right; flex-shrink: 0; }

/* ============================================================
   COURSE VIEW
   ============================================================ */
.course-view { max-width: 960px; margin: 0 auto; padding: 32px 28px; }

.cv-header {
  display: flex; align-items: flex-start; justify-content: space-between;
  margin-bottom: 32px; padding: 28px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-lg); position: relative; overflow: hidden;
}
.cv-header::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--cc, var(--accent)), transparent); }
.cv-header-left { display: flex; align-items: center; gap: 16px; }
.cv-emoji { font-size: 40px; line-height: 1; }
.cv-name { font-family: var(--font-display); font-size: 34px; font-weight: 700; letter-spacing: -1.5px; color: var(--text-1); margin-bottom: 6px; }
.cv-meta { display: flex; gap: 10px; align-items: center; }
.cv-semester-badge { background: var(--surface-el); border: 1px solid var(--border); border-radius: 20px; padding: 3px 10px; font-family: var(--font-mono); font-size: 10px; color: var(--text-2); letter-spacing: 1px; }
.cv-header-right { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; flex-shrink: 0; }
.cv-progress-pct { font-family: var(--font-mono); font-size: 40px; font-weight: 600; color: var(--cc, var(--accent)); line-height: 1; }
.cv-progress-lbl { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-3); text-align: right; }
.cv-progress-bar-wide { width: 180px; }

/* Weeks Timeline */
.weeks-timeline { display: flex; flex-direction: column; gap: 10px; }

.week-block {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-lg); overflow: hidden; transition: border-color 0.3s ease;
}
.week-block.alert { border-color: rgba(255,181,71,0.25); }

.wb-header {
  display: flex; align-items: center; gap: 14px;
  padding: 18px 22px; cursor: pointer;
  transition: background 0.2s ease; user-select: none;
}
.wb-header:hover { background: var(--surface-el); }

.wb-number {
  width: 32px; height: 32px; border-radius: 50%;
  background: var(--surface-el); border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 12px; font-weight: 600;
  color: var(--text-2); flex-shrink: 0; transition: var(--transition);
}
.week-block.expanded .wb-number, .wb-header:hover .wb-number { background: var(--cc, var(--accent)); color: #fff; border-color: var(--cc, var(--accent)); }

.wb-info { flex: 1; }
.wb-title { font-size: 14px; font-weight: 600; color: var(--text-1); margin-bottom: 5px; }
.wb-progress-inline { display: flex; align-items: center; gap: 8px; }
.wb-progress-bar-wrap { width: 100px; height: 3px; background: var(--surface-hi); border-radius: 2px; overflow: hidden; }
.wb-progress-bar { height: 100%; border-radius: 2px; background: var(--cc, var(--accent)); transition: width 0.6s cubic-bezier(0.4,0,0.2,1); }
.wb-progress-pct { font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--text-2); min-width: 32px; }
.wb-alert-badge { font-size: 9px; background: rgba(255,181,71,0.15); color: var(--warning); border: 1px solid rgba(255,181,71,0.3); padding: 2px 7px; border-radius: 20px; }
.wb-topics-count { font-size: 11px; color: var(--text-3); }

.wb-chevron { width: 18px; height: 18px; color: var(--text-3); transition: transform 0.3s cubic-bezier(0.4,0,0.2,1); flex-shrink: 0; }
.week-block.expanded .wb-chevron { transform: rotate(180deg); }

.wb-body { max-height: 0; overflow: hidden; transition: max-height 0.4s cubic-bezier(0.4,0,0.2,1); }
.week-block.expanded .wb-body { max-height: 2000px; }
.wb-body-inner { padding: 0 22px 18px; border-top: 1px solid var(--border); }

/* Topics */
.topics-list { display: flex; flex-direction: column; gap: 6px; margin-top: 14px; margin-bottom: 12px; }
.topic-row {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 16px;
  background: var(--surface-el); border: 1px solid var(--border);
  border-radius: var(--radius-md); cursor: pointer; transition: var(--transition);
}
.topic-row:hover { border-color: var(--cc, var(--accent)); background: var(--surface-hi); }
.topic-priority-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.priority-alta { background: var(--danger); }
.priority-media { background: var(--warning); }
.priority-baja { background: var(--text-3); }
.topic-title { flex: 1; font-size: 13px; font-weight: 500; color: var(--text-1); }
.topic-progress-area { display: flex; align-items: center; gap: 8px; }
.topic-progress-mini { width: 70px; height: 3px; background: var(--surface-hi); border-radius: 2px; overflow: hidden; }
.topic-progress-fill { height: 100%; border-radius: 2px; background: var(--cc, var(--accent)); transition: width 0.5s cubic-bezier(0.4,0,0.2,1); }
.topic-pct { font-family: var(--font-mono); font-size: 11px; color: var(--text-2); min-width: 28px; text-align: right; }
.topic-materials-count { font-size: 11px; color: var(--text-3); }
.topic-complete-badge { font-size: 10px; background: var(--teal-dim); color: var(--teal); border: 1px solid rgba(0,229,204,0.3); padding: 2px 7px; border-radius: 20px; }

.wb-add-topic {
  display: flex; align-items: center; gap: 8px;
  padding: 9px 14px; border: 1px dashed var(--border-md);
  border-radius: var(--radius-md); color: var(--text-3);
  font-size: 12px; transition: var(--transition); width: 100%;
}
.wb-add-topic:hover { border-color: var(--cc, var(--accent)); color: var(--cc, var(--accent)); background: var(--cc-dim, var(--accent-dim)); }

.add-week-btn {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  padding: 16px; border: 1px dashed var(--border-md);
  border-radius: var(--radius-lg); color: var(--text-3);
  font-size: 13px; transition: var(--transition); width: 100%;
}
.add-week-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-dim); }

.wb-actions-bar { display: flex; gap: 8px; padding-top: 10px; border-top: 1px solid var(--border); margin-top: 6px; }
.wb-del-btn { margin-left: auto; padding: 5px 10px; border-radius: var(--radius-sm); border: 1px solid var(--border); font-size: 11px; color: var(--text-3); transition: var(--transition); }
.wb-del-btn:hover { border-color: rgba(255,77,109,0.4); color: var(--danger); background: rgba(255,77,109,0.08); }

/* ============================================================
   TOPIC PANEL
   ============================================================ */
.panel-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);
  z-index: 200; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
}
.panel-overlay.active { opacity: 1; pointer-events: all; }

.topic-panel {
  position: fixed; top: 0; right: 0; bottom: 0; width: 500px;
  background: var(--surface); border-left: 1px solid var(--border);
  z-index: 201; overflow-y: auto;
  transform: translateX(100%);
  transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
}
.topic-panel.active { transform: translateX(0); }

.tp-header {
  position: sticky; top: 0; background: var(--surface);
  border-bottom: 1px solid var(--border); padding: 22px; z-index: 10;
}
.tp-course-tag { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 10px; }
.tp-title-edit { font-family: var(--font-display); font-size: 26px; font-weight: 700; letter-spacing: -0.5px; color: var(--text-1); background: none; border: none; width: 100%; border-bottom: 2px solid transparent; padding: 4px 0; transition: border-color 0.2s ease; resize: none; line-height: 1.2; }
.tp-title-edit:focus { border-bottom-color: var(--accent); outline: none; }
.tp-desc-edit { font-size: 13px; color: var(--text-2); background: none; border: none; width: 100%; margin-top: 6px; resize: none; line-height: 1.6; }
.tp-desc-edit:focus { outline: none; color: var(--text-1); }
.tp-desc-edit::placeholder { color: var(--text-3); }
.tp-close { position: absolute; top: 22px; right: 22px; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); color: var(--text-3); transition: var(--transition); }
.tp-close:hover { background: var(--surface-el); color: var(--text-1); }

.tp-body { padding: 22px; }

.tp-progress-section { margin-bottom: 24px; padding: 18px; background: var(--surface-el); border-radius: var(--radius-md); border: 1px solid var(--border); }
.tp-progress-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
.tp-progress-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-3); }
.tp-progress-pct { font-family: var(--font-mono); font-size: 28px; font-weight: 600; color: var(--cc, var(--accent)); }
.tp-progress-bar-wrap { height: 6px; background: var(--surface-hi); border-radius: 3px; overflow: hidden; margin-bottom: 10px; }
.tp-progress-bar { height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--cc, var(--accent)), var(--teal)); transition: width 0.6s cubic-bezier(0.4,0,0.2,1); }
.tp-progress-sub { font-size: 11px; color: var(--text-3); }

/* ============================================================
   PENDIENTES — Section in topic panel
   ============================================================ */
.tp-pendientes-section {
  margin-bottom: 24px;
  background: var(--surface-el);
  border: 1px solid rgba(255,181,71,0.18);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.tp-pendientes-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px;
  background: rgba(255,181,71,0.05);
  border-bottom: 1px solid rgba(255,181,71,0.12);
}

.tp-pendientes-title-row {
  display: flex; align-items: center; gap: 8px;
}

.tp-pendientes-label {
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 1.5px;
  color: var(--warning);
}

.tp-pendientes-badge {
  font-family: var(--font-mono); font-size: 10px; font-weight: 600;
  background: rgba(255,181,71,0.15); color: var(--warning);
  border: 1px solid rgba(255,181,71,0.3);
  padding: 1px 6px; border-radius: 20px;
  transition: var(--transition);
}
.tp-pendientes-badge.all-done {
  background: rgba(62,224,160,0.1); color: var(--success);
  border-color: rgba(62,224,160,0.3);
}

.tp-pendientes-list { padding: 8px 12px 10px; }

.tp-pend-item {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 10px; border-radius: var(--radius-sm);
  cursor: pointer; transition: var(--transition);
  border: 1px solid transparent; margin-bottom: 4px;
}
.tp-pend-item:last-child { margin-bottom: 0; }
.tp-pend-item:hover { background: var(--surface-hi); border-color: var(--border); }
.tp-pend-item.done-item { opacity: 0.5; }
.tp-pend-item.done-item .tp-pend-name { text-decoration: line-through; color: var(--text-3); }

.tp-pend-check {
  width: 18px; height: 18px; border-radius: 5px;
  border: 2px solid rgba(255,181,71,0.4);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1);
}
.tp-pend-item.done-item .tp-pend-check {
  background: var(--success); border-color: var(--success);
  transform: scale(1.1); box-shadow: 0 0 8px rgba(62,224,160,0.3);
}
.tp-pend-check svg { opacity: 0; width: 9px; height: 9px; transition: opacity 0.15s ease; }
.tp-pend-item.done-item .tp-pend-check svg { opacity: 1; }

.tp-pend-icon { font-size: 13px; flex-shrink: 0; }
.tp-pend-name { font-size: 12px; font-weight: 500; color: var(--text-1); flex: 1; }

.tp-pendientes-all-done {
  display: flex; align-items: center; gap: 8px;
  padding: 14px 16px;
  font-size: 12px; color: var(--success);
  font-weight: 500;
}

/* ============================================================
   TOPIC PANEL — Rest of sections
   ============================================================ */
.tp-section { margin-bottom: 24px; }
.tp-section-title { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-3); margin-bottom: 10px; font-weight: 600; }

.priority-toggle { display: flex; gap: 6px; }
.priority-btn { flex: 1; padding: 9px; border-radius: var(--radius-md); border: 1px solid var(--border); font-size: 11px; font-weight: 600; text-align: center; transition: var(--transition); color: var(--text-2); background: var(--surface-el); }
.priority-btn:hover { border-color: var(--border-md); color: var(--text-1); }
.priority-btn.active[data-p="alta"] { background: rgba(255,77,109,0.15); border-color: var(--danger); color: var(--danger); }
.priority-btn.active[data-p="media"] { background: rgba(255,181,71,0.15); border-color: var(--warning); color: var(--warning); }
.priority-btn.active[data-p="baja"] { background: rgba(92,100,120,0.2); border-color: rgba(92,100,120,0.5); color: var(--text-2); }

/* Materials */
.materials-list { display: flex; flex-direction: column; gap: 6px; }
.material-item { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: var(--surface-el); border: 1px solid var(--border); border-radius: var(--radius-md); transition: var(--transition); }
.material-item.not-applicable { opacity: 0.4; }
.material-item:hover { border-color: var(--border-md); }

.material-check { width: 20px; height: 20px; border-radius: 5px; border: 2px solid var(--border-md); display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1); }
.material-check.checked { background: var(--cc, var(--accent)); border-color: var(--cc, var(--accent)); transform: scale(1.1); box-shadow: 0 0 10px var(--cc-dim, var(--accent-dim)); }
.material-check.checked svg { opacity: 1; }
.material-check svg { opacity: 0; transition: opacity 0.15s ease; width: 10px; height: 10px; }

.material-icon { font-size: 14px; width: 22px; text-align: center; flex-shrink: 0; }
.material-name { flex: 1; font-size: 12px; font-weight: 500; color: var(--text-1); }
.material-item.not-applicable .material-name { text-decoration: line-through; color: var(--text-3); }

.material-applicable-toggle { width: 26px; height: 14px; background: var(--surface-hi); border-radius: 7px; position: relative; cursor: pointer; flex-shrink: 0; transition: background 0.2s ease; border: 1px solid var(--border); }
.material-applicable-toggle.on { background: rgba(108,99,255,0.4); border-color: var(--accent); }
.material-applicable-toggle::after { content: ''; position: absolute; top: 1px; left: 1px; width: 10px; height: 10px; border-radius: 50%; background: var(--text-3); transition: transform 0.2s cubic-bezier(0.4,0,0.2,1), background 0.2s ease; }
.material-applicable-toggle.on::after { transform: translateX(12px); background: var(--accent); }

/* Notes */
.tp-notes { width: 100%; background: var(--surface-el); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 14px; color: var(--text-1); font-size: 13px; line-height: 1.7; resize: vertical; min-height: 100px; transition: border-color 0.2s ease; }
.tp-notes:focus { border-color: var(--accent); outline: none; }
.tp-notes::placeholder { color: var(--text-3); }
.tp-date { margin-top: 14px; font-family: var(--font-mono); font-size: 10px; color: var(--text-3); text-align: right; }

.tp-delete-topic { display: flex; align-items: center; gap: 6px; margin-top: 16px; padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-md); font-size: 11px; color: var(--text-3); transition: var(--transition); }
.tp-delete-topic:hover { border-color: rgba(255,77,109,0.4); color: var(--danger); background: rgba(255,77,109,0.06); }

/* ============================================================
   MODALS
   ============================================================ */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); z-index: 300; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.25s ease; }
.modal-overlay.active { opacity: 1; pointer-events: all; }

.modal { background: var(--surface-el); border: 1px solid var(--border-md); border-radius: var(--radius-xl); padding: 32px; width: 460px; max-width: calc(100vw - 48px); box-shadow: var(--shadow-lg); transform: scale(0.95) translateY(10px); transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1); }
.modal-overlay.active .modal { transform: scale(1) translateY(0); }
.modal.modal-wide { width: 560px; }

.modal-title { font-family: var(--font-display); font-size: 24px; font-weight: 700; letter-spacing: -0.5px; color: var(--text-1); margin-bottom: 4px; }
.modal-subtitle { font-size: 13px; color: var(--text-2); margin-bottom: 24px; }

.form-group { margin-bottom: 18px; }
.form-label { display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: var(--text-3); margin-bottom: 7px; }
.form-input { width: 100%; background: var(--surface); border: 1px solid var(--border-md); border-radius: var(--radius-md); padding: 11px 14px; font-size: 13px; color: var(--text-1); transition: border-color 0.2s ease, background 0.2s ease; }
.form-input:focus { border-color: var(--accent); outline: none; background: var(--surface-hi); }
.form-input::placeholder { color: var(--text-3); }
.form-textarea { min-height: 80px; resize: vertical; line-height: 1.6; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

.emoji-picker { display: flex; gap: 6px; flex-wrap: wrap; }
.emoji-opt { width: 40px; height: 40px; border-radius: var(--radius-md); border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 20px; cursor: pointer; transition: var(--transition); }
.emoji-opt:hover { border-color: var(--border-md); background: var(--surface-hi); }
.emoji-opt.selected { border-color: var(--accent); background: var(--accent-dim); }

.color-picker { display: flex; gap: 10px; flex-wrap: wrap; }
.color-opt { width: 30px; height: 30px; border-radius: 50%; cursor: pointer; border: 3px solid transparent; transition: var(--transition); position: relative; }
.color-opt::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid transparent; transition: border-color 0.2s ease; }
.color-opt.selected::after { border-color: currentColor; }

.modal-actions { display: flex; gap: 10px; margin-top: 24px; justify-content: flex-end; }
.btn-cancel { padding: 10px 18px; border-radius: var(--radius-md); border: 1px solid var(--border); font-size: 13px; font-weight: 500; color: var(--text-2); transition: var(--transition); }
.btn-cancel:hover { color: var(--text-1); border-color: var(--border-md); background: var(--surface-hi); }
.btn-confirm { padding: 10px 22px; border-radius: var(--radius-md); background: var(--accent); color: #fff; font-size: 13px; font-weight: 600; transition: var(--transition); }
.btn-confirm:hover { background: #7B73FF; }
.btn-danger-confirm { padding: 10px 22px; border-radius: var(--radius-md); background: var(--danger); color: #fff; font-size: 13px; font-weight: 600; transition: var(--transition); }
.btn-danger-confirm:hover { background: #ff3357; }

/* Export/Import Modal */
.export-tabs { display: flex; gap: 2px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; margin-bottom: 20px; }
.export-tab { flex: 1; padding: 9px 16px; font-size: 12px; font-weight: 500; color: var(--text-2); transition: var(--transition); text-align: center; }
.export-tab.active { background: var(--accent); color: #fff; }
.export-tab:hover:not(.active) { background: var(--surface-el); color: var(--text-1); }

.export-panel { display: none; }
.export-panel.active { display: block; }

.json-box { width: 100%; height: 200px; background: var(--surface); border: 1px solid var(--border-md); border-radius: var(--radius-md); padding: 14px; color: var(--text-2); font-family: var(--font-mono); font-size: 11px; line-height: 1.6; resize: vertical; transition: border-color 0.2s ease; }
.json-box:focus { border-color: var(--accent); outline: none; color: var(--text-1); }

.export-info { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: var(--radius-md); background: var(--surface); border: 1px solid var(--border); font-size: 12px; color: var(--text-2); margin-bottom: 14px; }
.export-info svg { width: 14px; height: 14px; color: var(--accent); flex-shrink: 0; }

.import-warning { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: var(--radius-md); background: rgba(255,181,71,0.08); border: 1px solid rgba(255,181,71,0.25); font-size: 12px; color: var(--warning); margin-bottom: 14px; }
.import-warning svg { width: 14px; height: 14px; flex-shrink: 0; }

.copy-success { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--success); opacity: 0; transition: opacity 0.3s ease; }
.copy-success.visible { opacity: 1; }

/* Search Dropdown */
.search-dropdown { position: absolute; top: calc(100% + 6px); left: 0; right: 0; background: var(--surface-el); border: 1px solid var(--border-md); border-radius: var(--radius-md); max-height: 300px; overflow-y: auto; box-shadow: var(--shadow-md); z-index: 150; display: none; }
.search-dropdown.visible { display: block; }
.search-result { padding: 10px 14px; cursor: pointer; border-bottom: 1px solid var(--border); transition: background 0.15s ease; display: flex; flex-direction: column; gap: 2px; }
.search-result:last-child { border-bottom: none; }
.search-result:hover { background: var(--surface-hi); }
.sr-topic { font-size: 13px; font-weight: 500; color: var(--text-1); }
.sr-path { font-size: 11px; color: var(--text-3); }
.sr-highlight { color: var(--accent); }

/* Toasts */
.toast-container { position: fixed; bottom: 28px; right: 28px; z-index: 500; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
.toast { background: var(--surface-hi); border: 1px solid var(--border-md); border-radius: var(--radius-md); padding: 12px 18px; font-size: 13px; color: var(--text-1); box-shadow: var(--shadow-md); display: flex; align-items: center; gap: 8px; transform: translateX(120%); transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1); pointer-events: auto; max-width: 300px; }
.toast.visible { transform: translateX(0); }
.toast.success { border-color: rgba(62,224,160,0.3); }
.toast.error { border-color: rgba(255,77,109,0.3); }

.hidden { display: none !important; }
.divider { height: 1px; background: var(--border); margin: 16px 0; }
</style>
</head>
